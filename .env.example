# Exemples uniquement pour le développement local ; aucun secret de production.
NODE_ENV=development
PORT=3001

POSTGRES_DB=candidly_dev
POSTGRES_USER=candidly
POSTGRES_PASSWORD=change_me_local_only
# Port hôte ; le port interne PostgreSQL reste 5432.
POSTGRES_PORT=5432

# Maintenir utilisateur, mot de passe, base et port cohérents avec POSTGRES_*.
DATABASE_URL=postgresql://candidly:change_me_local_only@localhost:5432/candidly_dev

REDIS_HOST=localhost
# Port hôte ; le port interne Redis reste 6379.
REDIS_PORT=6379

CORS_ORIGIN=http://localhost:3000
