# Exemples uniquement pour le développement local ; aucun secret de production.
NODE_ENV=development
PORT=3001

POSTGRES_DB=candidly_dev
POSTGRES_USER=candidly
POSTGRES_PASSWORD=change_me_local_only
# Port hôte ; le port interne PostgreSQL reste 5432.
POSTGRES_PORT=5432

# Maintenir utilisateur, mot de passe, base et port cohérents avec POSTGRES_*.
DATABASE_URL=postgresql://candidly:change_me_local_only@localhost:5432/candidly_dev

REDIS_HOST=localhost
# Port hôte ; le port interne Redis reste 6379.
REDIS_PORT=6379

CORS_ORIGIN=http://localhost:3000

# Transport local seulement : fichiers privés, aucun email réellement délivré.
FRONTEND_URL=http://localhost:3000
EMAIL_TRANSPORT=local
EMAIL_LOCAL_DIRECTORY=.local-emails
# Entiers positifs : TTL <= 604800, cooldown <= 86400, intervalle <= 3600.
EMAIL_VERIFICATION_TTL_SECONDS=86400
EMAIL_RESEND_COOLDOWN_SECONDS=60
EMAIL_RETRY_INTERVAL_SECONDS=30

# Générer une clé locale : node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Remplacer ce marqueur dans .env uniquement ; aucune clé utilisable n'est versionnée.
JWT_SIGNING_KEY=REPLACE_WITH_GENERATED_BASE64_KEY
JWT_ISSUER=candidly-api
JWT_AUDIENCE=candidly-web
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# Récupération du mot de passe : TTL et cooldown en secondes (1 à 86400).
PASSWORD_RESET_TTL_SECONDS=1800
PASSWORD_RESET_COOLDOWN_SECONDS=60

# Taille JSON/form maximale ; pas de corps compressé (16384 octets par défaut).
HTTP_BODY_LIMIT_BYTES=16384
# Vide = aucune confiance en X-Forwarded-For. IP exacte d'un proxy connu seulement.
TRUSTED_PROXY_IP=
