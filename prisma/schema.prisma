generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                           String                   @id @default(uuid()) @db.Uuid
  email                        String                   @unique @db.VarChar(254)
  passwordHash                 String                   @db.VarChar(255)
  firstName                    String                   @db.VarChar(100)
  lastName                     String                   @db.VarChar(100)
  emailVerifiedAt              DateTime?                @db.Timestamptz(3)
  verificationRequestedAt      DateTime?                @db.Timestamptz(3)
  verificationLastRequestedAt  DateTime                 @default(now()) @db.Timestamptz(3)
  createdAt                    DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt                    DateTime                 @updatedAt @db.Timestamptz(3)
  verificationTokens           EmailVerificationToken[]
  sessions                     Session[]
  preference                   UserPreference?
  passwordResetTokens          PasswordResetToken[]
  passwordResetRequestedAt     DateTime?                @db.Timestamptz(3)
  passwordResetLastRequestedAt DateTime?                @db.Timestamptz(3)

  @@index([verificationRequestedAt])
  @@index([passwordResetRequestedAt])
}

model EmailVerificationToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique @db.Char(64)
  expiresAt  DateTime  @db.Timestamptz(3)
  consumedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consumedAt])
}

model Session {
  id               String                @id @default(uuid()) @db.Uuid
  userId           String                @db.Uuid
  refreshTokenHash String                @unique @db.Char(64)
  expiresAt        DateTime              @db.Timestamptz(3)
  revokedAt        DateTime?             @db.Timestamptz(3)
  createdAt        DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime              @updatedAt @db.Timestamptz(3)
  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  consumedTokens   SessionRefreshToken[]

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model SessionRefreshToken {
  tokenHash  String   @id @db.Char(64)
  sessionId  String   @db.Uuid
  consumedAt DateTime @default(now()) @db.Timestamptz(3)
  session    Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model UserPreference {
  userId    String   @id @db.Uuid
  locale    String   @default("fr") @db.VarChar(20)
  timezone  String   @default("Africa/Abidjan") @db.VarChar(100)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique @db.Char(64)
  expiresAt  DateTime  @db.Timestamptz(3)
  consumedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consumedAt])
}
